--- !u!114 &622208150
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 622208147}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f9659f071e1950c4f8e7fe72641b1660, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 622208148}
  bathhouseIntroDialogues:
  - dayName: 
    lines: []
  - dayName: Day 2
    lines:
    - textId: 
      order: 0
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6211\u6765\u4E86\uFF01\u60F3\u4E86\u60F3\u8FD9\u91CC\u786E\u5B9E\u4E0D\u9519,\u6BD4\u8D77\u516C\u53F8\uFF01\u6628\u5929\u6413\u5B8C\u4E0B\u6765\u73B0\u5728\u4E00\u70B9\u4E5F\u4E0D\u89C9\u5F97\u7D2F\u4E86"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4E5F\u770B\u4E0D\u5230\u6628\u5929\u90A3\u4E9B\u9ED1\u6F06\u6F06\u7684\u6CE5\u5DF4\u4E86"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u597D\u554A\uFF0C\u5C0F\u4F19\u5B50"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u6765\u6559\u4F60\uFF01\u90A3\u4F60\u5C31\u6B63\u5F0F\u6210\u4E3A\u6211\u7684\u5458\u5DE5\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: 
      side: 
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u556A\uFF01\u4E00\u5757\u6563\u53D1\u7740\u795E\u79D8\u5149\u8292\u7684\u5E03\u6599\u7838\u5728\u4F60\u7684\u8138\u4E0A\u3002\u83B7\u5F97\u521D\u59CB\u6B66\u5668\uFF1A\u3010\u9AD8\u7EA7\u6413\u6FA1\u5DFE\u3011"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6309WASD\u4E0A\u4E0B\u8D70\u52A8\uFF0C\u60F3\u8981\u4E9B\u8D81\u624B\u7684\u5DE5\u5177\u53BB\u67DC\u53F0\u6309F\u952E\uFF0C\u8BB0\u4F4F\u6CA1\uFF01\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: ac0535dcc348ae44ca02e86c3dfa7287, type: 3}
      isLeftPortrait: 0
      text: "\u53EF\u4EE5\u518D\u8BF4\u4E00\u904D\u4E0D......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6309WASD\u4E0A\u4E0B\u8D70\u52A8\uFF0C\u60F3\u8981\u4E9B\u8D81\u624B\u7684\u5DE5\u5177\u53BB\u67DC\u53F0\u6309F\u952E\uFF0C\u6211\u4E0D\u4F1A\u518D\u8BF4\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u8FD8\u6709\uFF0C\u542C\u7740\uFF0C\u60F3\u548C\u987E\u5BA2\u804A\u5929\u4E5F\u6309F\u952E\uFF0C\u63A5\u5F85\u5B8C\u4E4B\u540E\u7AD9\u84DD\u8272\u5730\u6BEF\u4E0A\u6309F\u952E\uFF01"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4E00\u5B9A\u8981\u7262\u8BB0\u4E8E\u5FC3\u77E5\u9053\u5417\uFF01"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u597D\u7684\uFF0C\u6211\u8BB0\u4F4F\u4E86\u3002"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u521A\u597D\u73B0\u5728\u6709\u4E2A\u9884\u7EA6\u7684\u5BA2\u4EBA\u5230\u4E86,\u5C31\u4F60\u4E0A\u5427,\u6211\u4F1A\u5728\u65C1\u8FB9\u770B\u7740\u7684\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 3
    lines:
    - textId: 
      order: 0
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: 9dd247752bf53b44bb26469a85071715, type: 3}
      isLeftPortrait: 0
      text: "\u55EF...\u6628\u5929\u7684\u5B9E\u4E60\u751F\u9F20\u9F20\u771F\u8F9E\u804C\u4E86\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u53D1\u4EC0\u4E48\u5446\u5462\uFF1F\u6628\u5929\u7684\u63D0\u6210\u62FF\u7740\uFF0C\u53BB\u67DC\u53F0\u90A3\u8FB9\u641E\u70B9\u82B1\u8336\u559D\u559D\uFF0C\u770B\u4F60\u7D2F\u7684"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: 
    lines: []
  - dayName: 
    lines: []
