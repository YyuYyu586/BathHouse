      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u6FA1\u5802\u7684\u96FE\u6C14\u5FFD\u7136\u53D8\u6D53\u4E86......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 114
      order: 114
      speakerName: "\u7CFB\u7EDF"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u96FE\u6C14\u91CC\u4F20\u51FA\u7EC6\u788E\u7684\u58F0\u97F3\u2014\u2014\u201C\u533B\u751F\uFF0C\u6211\u662F\u4E0D\u662F\u5B8C\u4E86\uFF1F\u201D\u201C\u4F60\u518D\u8DDF\u6211\u8BF4\u4E00\u904D\u2026\u2026\u201D\u201C\u6211\u662F\u4E0D\u662F\u6CA1\u6551\u4E86\uFF1F\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 115
      order: 115
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\uFF08\u4E0D\u597D\u2026\u2026\u90A3\u4E9B\u96FE\u6C14\u805A\u8D77\u6765\u4E86\uFF01\uFF09"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 116
      order: 116
      speakerName: "\u5C0F\u798F"
      portraitSourceName: none
      side: R
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u987E\u5BA2\u987E\u5BA2\uFF0C\u6211\u4EEC\u73B0\u5728\u8FDB\u53BB\u5427\uFF0C\u4E1C\u897F\u5DF2\u7ECF\u5907\u597D\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: DLC Day 3 BeforeCombat
    lines:
    - textId: 146
      order: 146
