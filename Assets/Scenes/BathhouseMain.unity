      portrait: {fileID: 21300000, guid: d8bc113f0b8ef3948b6a4199ac0bff13, type: 3}
      isLeftPortrait: 1
      text: "\u8001\u677F\uFF0C\u5FEB\u5FEB\u5FEB\uFF01\u521A\u521A\u4E0B\u66B4\u96E8\u6211\u9001\u9644\u8FD1\u7684\u5730\u65B9\u641E\u5F97\u5168\u8EAB\u90FD\u6E7F\u4E86\uFF01\u6211\u4E4B\u540E\u8FD8\u8981\u53BB\u627E\u6211\u5973\u513F\uFF0C\u80FD\u7ED9\u6211\u5B89\u6392\u4E00\u4E2A\u624B\u901F\u5FEB\u7684\u5E08\u5085\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 119
      order: 3
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u597D\u561E\u597D\u561E\uFF0C\u522B\u7740\u6025\u5440"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 120
      order: 4
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4ED6\u8EAB\u4E0A\u2026\u2026\u8FD9\u56E2\u75AF\u72C2\u8086\u8650\u7684\u72C2\u98CE\uFF01\u5439\u5F97\u4EBA\u773C\u775B\u90FD\u7741\u4E0D\u5F00\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 121
      order: 5
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6BCF\u5929\u5728\u9A6C\u8DEF\u4E0A\u72C2\u98D9\uFF0C\u6700\u540E\u8FD9\u9635\u5996\u98CE\u5168\u522E\u8FDB\u4E86\u81EA\u5DF1\u5FC3\u91CC\u53BB\u54AF\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 122
      order: 6
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u53BB\u5427\uFF0C\u4ECA\u5929\u5C31\u5F53\u7EC3\u7EC3\u624B\u901F\u3002\u8BA9\u4ED6\u505C\u4E0B\u6765\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 123
      order: 7
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5BF9\u4ED8\u8FD9\u79CD\u654C\u4EBA\u4E5F\u53EF\u4EE5\u4F7F\u7528\u7729\u6655\u6280\u80FD\uFF0C\u9632\u6B62\u5BF9\u65B9\u5728\u4E00\u56DE\u5408\u5185\u653B\u51FB\u4F60\u591A\u6B21"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 124
      order: 8
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5662\uFF0C\u8FD8\u8981\u6CE8\u610F\u70B9\uFF0C\u522B\u5F04\u4E71\u8001\u5A18\u7684\u53D1\u578B\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 125
      order: 9
      speakerName: "\u5C0F\u798F"
      portraitSourceName: lihui_dafu_pibei
      side: R
      portrait: {fileID: 21300000, guid: 9dd247752bf53b44bb26469a85071715, type: 3}
      isLeftPortrait: 0
      text: "\u597D\u7684\uFF0C\u8001\u677F..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 6
    lines:
    - textId: 146
      order: 1
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng
      side: L
      portrait: {fileID: 21300000, guid: 02d879efdb84dea4d8e52fcb5ef01b27, type: 3}
      isLeftPortrait: 1
      text: "\u7EE9\u70B9\u4E0D\u591F...\u5B9E\u4E60\u6CA1\u7740\u843D...\u53C8\u6CA1\u6CD5\u4FDD\u7814..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 147
      order: 2
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u60A8\u597D\u2026\uFF1F\u8BF7\u95EE\u9700\u8981\u4EC0\u4E48\u670D\u52A1\u5462\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 148
      order: 3
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: 
      side: L
      portrait: {fileID: 21300000, guid: 02d879efdb84dea4d8e52fcb5ef01b27, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u597D\uFF0C\u8BF7\u95EE\u53EF\u4EE5\u5E26\u6211\u7684\u5E73\u677F\u8FDB\u53BB\u4E0D\uFF1F\u6211\u5F97\u628A\u8FD9\u4E2A\u6155\u8BFE\u5237\u5B8C..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 149
      order: 4
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u53EF\u4EE5\u7684\u54C8\uFF0C\u4F46\u662F\u6211\u4EEC\u8FD9\u513F\u7684\u5BA2\u4EBA\u4E00\u822C\u6413\u7740\u6413\u7740\u90FD\u7761\u7740\u4E86\uFF0C\u8FD9\u8FB9\u8BF7\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 150
      order: 5
      speakerName: "\u5C0F\u798F"
      portraitSourceName: Jinsao_portrait
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\uFF08OMG\u4EFF\u4F5B\u770B\u89C1\u4E86\u5F53\u5E74\u7684\u81EA\u5DF1\uFF0C\u90A3\u4E9B\u5927\u5768\u5927\u5768\u7684\u6CE1\u6CE1\u662F\u4EC0\u4E48\uFF01\uFF1F\uFF09"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 151
      order: 6
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u8FD9\u662F\u5B83\u8111\u5B50\u91CC\u7684\u566A\u97F3......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 152
      order: 7
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u88AB\u5916\u5728\u7684\u4FE1\u606F\u585E\u6EE1\u4E86\u8111\u5B50\uFF0C\u81EA\u5DF1\u90FD\u81EA\u8EAB\u96BE\u4FDD\u4E86\u3002\u53BB\uFF0C\u7528\u4F60\u8FD9\u51E0\u5929\u953B\u70BC\u51FA\u6765\u7684\u624B\u6CD5\uFF0C\u628A\u90A3\u4E9B\u8FF7\u8499\u7684\u6CE1\u6CE1\u5168\u6233\u7834\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 153
      order: 8
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u597D\u561E\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 7
    lines:
    - textId: 165
      order: 2
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: lihui_zhuguan_bengkui
      side: L
      portrait: {fileID: 21300000, guid: 9caed327c93de0944967eb303b4bca63, type: 3}
      isLeftPortrait: 1
      text: "\u8001\u677F\uFF0C\u6765\u4E00\u4E2A\u548C\u4E0A\u6B21\u4E00\u6837\u7684\u6413\u6FA1\u5957\u9910\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 166
      order: 3
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u597D\u561E\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 167
      order: 4
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: lihui_zhuguan_bengkui
      side: L
      portrait: {fileID: 21300000, guid: 9caed327c93de0944967eb303b4bca63, type: 3}
      isLeftPortrait: 1
      text: "\u5662\uFF0C\u7A0D\u7B49\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 168
      order: 5
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: lihui_zhuguan_bengkui
      side: L
      portrait: {fileID: 21300000, guid: 9caed327c93de0944967eb303b4bca63, type: 3}
      isLeftPortrait: 1
      text: "\u201C\u6536\u5230\u3002\u597D\u7684\u3002\u9A6C\u4E0A\u6539...\u8F9B\u82E6\u5927\u5BB6\u5468\u672B\u62C9\u4E2A\u4F1A...\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 169
      order: 6
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4ED6\u80CC\u4E0A\u7684\u4E1C\u897F\u5728\u75AF\u72C2\u589E\u751F\uFF0C\u8FD9\u662F......\u554A\uFF1F\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 170
      order: 7
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: none
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u201C\u5BA2\u6237\u8BF4\u8FD8\u662F\u611F\u89C9\u4E0D\u592A\u5BF9\uFF0C\u5468\u672B\u4F60\u5E26\u5E95\u4E0B\u5458\u5DE5\u518D\u51FA\u4E09\u7248\u65B9\u6848\u5BF9\u6BD4\u4E0B\u5427\u3002\u2019\u2019"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 171
      order: 8
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: lihui_zhuguan_bengkui
      side: L
      portrait: {fileID: 21300000, guid: 9caed327c93de0944967eb303b4bca63, type: 3}
      isLeftPortrait: 1
      text: "\u51FA\u4F60\u5927\u7237\u7684\u65B9\u6848...\u51ED\u4EC0\u4E48\u6BCF\u6B21\u90FD\u662F\u6211\u88C5\u5B59\u5B50\u53BB\u538B\u69A8\u5458\u5DE5\u554A..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 172
      order: 9
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u7CDF\u4E86\uFF01\u8FD9\u5B59\u5B50\uFF0C\u5B83\u8EAB\u4E0A\u7684\u5916\u58F3\u5728\u8FC5\u901F\u6210\u957F\uFF0C\u5FEB\u628A\u8001\u5A18\u7684\u62DB\u724C\u641E\u57AE\u4E86\uFF01\u5FEB\u963B\u6B62\u4ED6\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  dlcBathhouseIntroDialogues:
  - dayName: 
    lines: []
  - dayName: DLC Day 2 BathhouseIntro
    lines:
    - textId: 80
      order: 80
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u65B0\u7684\u4E00\u5929\u4E86\uFF0C\u60F3\u7528\u70B9\u522B\u7684\u4E1C\u897F\u4E0D\uFF1F\u8FC7\u6765\uFF0C\u6211\u7ED9\u4F60\u4E2A\u65B0\u5DE5\u5177\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 81
      order: 81
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u65B0\u5DE5\u5177\uFF1F\u662F\u4EC0\u4E48\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 82
      order: 82
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u73CD\u73E0\u6D74\u7403\uFF0C\u7528\u8D77\u6765\u53EF\u6709\u52B2\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 83
      order: 83
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\uFF01\u8C22\u8C22\u8001\u677F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 84
      order: 84
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u83B7\u5F97\u4E86\u3010\u73CD\u73E0\u6D74\u7403\u3011\u2014\u2014\u89E3\u9501\u6280\u80FD\u3010\u73CD\u73E0\u6D74\u7403\u5927\u51B2\u6D17\u3011\uFF01\u6218\u6597\u4E2D\u6309\u94AE\u663E\u793A\u4E3A\u3010\u8FDE\u51FB\u3011\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: DLC Day 3 BathhouseIntro
    lines:
    - textId: 141
      order: 141
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u7EC8\u4E8E\u5230\u4E86\uFF0C\u6211\u8001\u65E9\u4E70\u7684\u4E00\u6279\u80A5\u7682\uFF0C\u62FF\u53BB\u7528\u5427\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 142
      order: 142
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u2026\u2026\u8001\u677F\u8FDB\u65B0\u8D27\u4E86\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 143
      order: 143
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5E7F\u544A\u5199\u4EC0\u4E48\u7075\u9B42\u629B\u5149\uFF0C\u6D01\u51C0\u5565\u7684\u3002\u4E0D\u77E5\u9053\u6709\u6CA1\u6709\u90A3\u4E48\u597D\u7528\uFF0C\u4ECA\u5929\u4F60\u53EF\u4EE5\u8BD5\u8BD5\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 144
      order: 144
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6211\u4F1A\u5C0F\u5FC3\u7528\u7684\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 145
      order: 145
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u83B7\u5F97\u4E86\u3010\u9AD8\u7EA7\u80A5\u7682\u3011\u2014\u2014\u89E3\u9501\u6280\u80FD\u3010\u7075\u9B42\u629B\u5149\u3011\uFF01\u6218\u6597\u4E2D\u6309\u94AE\u663E\u793A\u4E3A\u3010\u7EC8\u7ED3\u3011\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
