      order: 48
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u4E07\u4E00\u6211\u6CA1\u63D0\u9192\uFF0C\u4E07\u4E00\u5B83\u6CA1\u6CE8\u610F\uFF0C\u4E07\u4E00\u4E0B\u6B21\u68C0\u67E5\u66F4\u7CDF\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 49
      order: 49
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u4E07\u4E00\u5B83\u660E\u660E\u53EF\u4EE5\u597D\u4E00\u70B9\uFF0C\u662F\u6211\u6CA1\u7167\u987E\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 50
      order: 50
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u54CE\u54DF\uFF0C\u522B\u5148\u628A\u81EA\u5DF1\u7ED5\u8FDB\u53BB\u4E86\u3002\u5148\u548C\u6211\u53BB\u6C64\u6C60\u5427\uFF0C\u4E1C\u897F\u5DF2\u7ECF\u51C6\u5907\u597D\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 51
      order: 51
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u597D\u2026\u2026"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 52
      order: 52
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\uFF08\u624B\u673A\u5C4F\u5E55\u4EAE\u4E86\u4E00\u4E0B\uFF0C\u7A7A\u6C14\u4E2D\u6D6E\u51FA\u7EC6\u5C0F\u7684\u5B57\u8FF9\u3002\uFF09"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 53
      order: 53
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u201C\u80FD\u4E0D\u80FD\u5403\u2026\u2026\u201D \u201C\u8981\u4E0D\u8981\u63D0\u9192\u2026\u2026\u201D
        \u201C\u8840\u7CD6\u9AD8\u600E\u4E48\u529E\u2026\u2026\u201D \u201C\u5BB6\u5C5E\u600E\u4E48\u7167\u987E\u2026\u2026\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 54
      order: 54
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\uFF08\u4E0D\u597D\uFF0C\u5F97\u5FEB\u70B9\u4E86\uFF01\uFF09"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: DLC Day 2 BeforeCombat
    lines:
    - textId: 85
      order: 85
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6B22\u8FCE\u5149\u4E34\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 86
      order: 86
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u2026\u2026\u4F60\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 87
      order: 87
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u7B2C\u4E00\u6B21\u6765\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 88
      order: 88
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u55EF\u3002\u540C\u4E8B\u8BF4\u8FD9\u91CC\u6CE1\u5B8C\u5F88\u8212\u670D\uFF0C\u8BA9\u6211\u6765\u8BD5\u8BD5\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 89
      order: 89
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4F60\u770B\u8D77\u6765\u5F88\u7D2F\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 90
      order: 90
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u8FD8\u597D\uFF0C\u5C31\u662F\u2026\u2026\uFF08\u4F4E\u5934\u770B\u624B\u673A\uFF0C\u6309\u706D\u5C4F\u5E55\uFF09\u6CA1\u4E8B\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 91
      order: 91
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\uFF08\u9012\u8336\uFF09\u5148\u559D\u53E3\u8336\u5427\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 92
      order: 92
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u554A\u2026\u2026\u597D\u3002\u6709\u4E2A\u60A3\u8005\uFF0C\u6BCF\u5929\u90FD\u53D1\u8840\u7CD6\u8BB0\u5F55\u7ED9\u6211\uFF0C\u6570\u5B57\u5FFD\u9AD8\u5FFD\u4F4E\u7684\uFF0C\u5B83\u5F88\u5BB3\u6015\uFF0C\u6211\u5728\u60F3\u600E\u4E48\u56DE\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 93
      order: 93
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u90FD\u4E0B\u73ED\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 94
      order: 94
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u53EF\u662F\u5B83\u53D1\u8FC7\u6765\u4E86\u3002\u6211\u4E0D\u56DE\u7684\u8BDD\uFF0C\u5B83\u4F1A\u4E0D\u4F1A\u89C9\u5F97\u6211\u4E0D\u591F\u8D1F\u8D23\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 95
      order: 95
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4F60\u6BCF\u5929\u8981\u56DE\u5F88\u591A\u6D88\u606F\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 96
      order: 96
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u55EF\u2026\u2026\u5BF9\u3002\u6709\u4EBA\u53D1\u8840\u7CD6\u8BB0\u5F55\uFF0C\u6709\u4EBA\u95EE\u80FD\u4E0D\u80FD\u5403\u8FD9\u4E2A\u90A3\u4E2A\uFF0C\u6709\u4EBA\u534A\u591C\u8BF4\u7761\u4E0D\u7740\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 97
      order: 97
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u5176\u5B9E\u6211\u77E5\u9053\uFF0C\u6709\u4E9B\u95EE\u9898\u4E0D\u7528\u9A6C\u4E0A\u56DE\u3002\u4F46\u5C31\u662F\u5FCD\u4E0D\u4F4F\u70B9\u5F00\uFF0C\u6015\u4E07\u4E00\u6F0F\u4E86\u4EC0\u4E48\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 98
      order: 98
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u4E0A\u5468\u6709\u4E2A\u65B0\u786E\u8BCA\u7684\u9F20\u9F20\uFF0C\u62FF\u7740\u5316\u9A8C\u5355\u95EE\u6211\uFF1A\u201C\u533B\u751F\uFF0C\u6211\u662F\u4E0D\u662F\u5B8C\u4E86\uFF1F\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 99
      order: 99
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u5F53\u65F6\u8DDF\u5B83\u8BF4\uFF0C\u53EA\u8981\u6162\u6162\u8C03\u6574\u996E\u98DF\u3001\u8FD0\u52A8\u548C\u7528\u836F\uFF0C\u8840\u7CD6\u662F\u53EF\u4EE5\u4E00\u70B9\u70B9\u7A33\u4E0B\u6765\u7684\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 100
      order: 100
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u5B83\u70B9\u4E86\u70B9\u5934\u8D70\u4E86\u3002\u4F46\u90A3\u5929\u665A\u4E0A\u6211\u8EBA\u5728\u5E8A\u4E0A\u4E00\u76F4\u5728\u60F3\u2014\u2014"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 101
      order: 101
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamstertired
      side: L
      portrait: {fileID: 21300000, guid: f7825c74c7a27b54a92ffbef7f0bcef7, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u662F\u4E0D\u662F\u8BF4\u592A\u8F7B\u4E86\uFF1F\u5B83\u4F1A\u4E0D\u4F1A\u89C9\u5F97\u6211\u4E0D\u5F53\u56DE\u4E8B\uFF1F\u8FD8\u662F\u8BF4\u592A\u91CD\u4E86\uFF1F\u5B83\u4F1A\u4E0D\u4F1A\u56DE\u53BB\u66F4\u5BB3\u6015\u4E86\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 102
      order: 102
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u4E0D\u662F\u6015\u81EA\u5DF1\u6CA1\u672C\u4E8B\uFF0C\u4F60\u662F\u62C5\u5FC3\u90A3\u53E5\u8BDD\u5728\u5B83\u5FC3\u91CC\u7684\u91CD\u91CF\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 103
      order: 103
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamstertired
      side: L
      portrait: {fileID: 21300000, guid: f7825c74c7a27b54a92ffbef7f0bcef7, type: 3}
      isLeftPortrait: 1
      text: "\u2026\u2026\u5BF9\u3002\u6211\u6015\u7684\u662F\u8BDD\u3002\u6015\u81EA\u5DF1\u54EA\u53E5\u8BDD\u6CA1\u8BF4\u5BF9\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 104
      order: 104
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u60A3\u8005\u95EE\u7684\u95EE\u9898\u591A\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 105
      order: 105
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u591A\u3002\u540C\u4E00\u4E2A\u95EE\u9898\uFF0C\u4E0D\u540C\u7684\u4EBA\u95EE\uFF0C\u540C\u4E00\u4E2A\u4EBA\u53CD\u590D\u95EE\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 106
      order: 106
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u201C\u533B\u751F\uFF0C\u8FD9\u4E2A\u836F\u996D\u524D\u8FD8\u662F\u996D\u540E\uFF1F\u201D\u201C\u8840\u7CD6\u591A\u5C11\u6B63\u5E38\uFF1F\u201D\u201C\u6211\u80FD\u4E0D\u80FD\u5403\u897F\u74DC\uFF1F\u201D\u201C\u6211\u8FD8\u8981\u5403\u591A\u4E45\uFF1F\u201D\u2014\u2014"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 107
      order: 107
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 998d5c91f8fc33b4ab45685bba683718, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u77E5\u9053\u5B83\u4EEC\u53EA\u662F\u5BB3\u6015\u3002\u4F46\u6BCF\u56DE\u7B54\u4E00\u6B21\uFF0C\u6211\u90FD\u5728\u60F3\u2014\u2014\u6211\u8FD9\u6B21\u8BF4\u6E05\u695A\u4E86\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 108
      order: 108
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u8FD9\u4E0D\u662F\u624B\u673A\u54CD\u3002\u662F\u8FD9\u91CC\u4E00\u76F4\u5728\u54CD\u3002\uFF08\u6307\u6307\u80F8\u53E3\uFF09"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 109
      order: 109
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamstertired
      side: L
      portrait: {fileID: 21300000, guid: f7825c74c7a27b54a92ffbef7f0bcef7, type: 3}
      isLeftPortrait: 1
      text: "\u2026\u2026\u55EF\u3002\u4E07\u4E00\u6211\u6CA1\u8BB2\u6E05\u695A\uFF0C\u4E07\u4E00\u5B83\u6CA1\u542C\u61C2\uFF0C\u4E07\u4E00\u5B83\u56E0\u4E3A\u6211\u7684\u8BDD\u66F4\u7126\u8651\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 110
      order: 110
      speakerName: "\u533B\u751F\u9F20"
      portraitSourceName: DoctorHamstertired
      side: L
      portrait: {fileID: 21300000, guid: f7825c74c7a27b54a92ffbef7f0bcef7, type: 3}
      isLeftPortrait: 1
      text: "\u8FD9\u4E9B\u4E8B\u60C5......\u5806\u5728\u4E00\u8D77\uFF0C\u6211\u89C9\u5F97\u81EA\u5DF1\u5598\u4E0D\u8FC7\u6C14\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 111
      order: 111
