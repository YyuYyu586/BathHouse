    lines: []
  beforeCombatDialogues:
  - dayName: 
    lines: []
  - dayName: Day 2
    lines:
    - textId: 52
      order: 13
      speakerName: "\u5B9E\u4E60\u751F\u9F20\u9F20"
      portraitSourceName: lihui_shixisheng_jusang
      side: L
      portrait: {fileID: 21300000, guid: 00a7dd9ec0ffa0e4ca69f93da857b042, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u597D,\u6211\u9884\u7EA6\u4E8615\uFF1A00\u7684\u4F4D\u7F6E......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 53
      order: 14
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u597D\u7684,\u54CE,\u4F60\u53BB\u4E00\u4E0B\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 54
      order: 15
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4F60\u597D,\u662F\u9884\u7EA615\uFF1A00\u7684\u9F20\u9F20\u5417\uFF1F\u8FD9\u8FB9\u8BF7\u54C8"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 55
      order: 16
      speakerName: "\u5B9E\u4E60\u751F\u9F20\u9F20"
      portraitSourceName: lihui_shixisheng_jusang
      side: L
      portrait: {fileID: 21300000, guid: 00a7dd9ec0ffa0e4ca69f93da857b042, type: 3}
      isLeftPortrait: 1
      text: "\u597D......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 56
      order: 17
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: none
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u73B0\u5728\u53EF\u4EE5\u53BB\u4E0A\u8FB9\u7684\u84DD\u8272\u5730\u6BEF\u51FA\u6309F\u952E\u8FDB\u5165\u70ED\u8840\u7684\u6413\u6FA1\u4E86\uFF01\uFF01\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 3
    lines:
    - textId: 72
      order: 3
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: lihui_zhuguan_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 7a6fee42ebe8be640ad45ee233859826, type: 3}
      isLeftPortrait: 1
      text: "\u54B3...\u73B0\u5728\u6709\u4F4D\u7F6E\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 73
      order: 4
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6709\u7684\uFF0C\u5148\u751F\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 74
      order: 5
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: lihui_zhuguan_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 7a6fee42ebe8be640ad45ee233859826, type: 3}
      isLeftPortrait: 1
      text: "\u9A6C\u4E0A\u7ED9\u6211\u5B89\u6392\u4E00\u4E2A30\u5206\u949F\u7684\u6D17\u6D74\u5957\u9910\u3002\u6211\u8FD8\u8981\u8D76\u7740\u53BB\u5F00\u4E2A\u4F1A\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 75
      order: 6
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u770B\u5230\u4EC0\u4E48\u4E86\uFF0C\u8FD9\u4E48\u60CA\u8BB6\uFF0C\u770B\u6765\u662F\u4E2A\u5927\u5BA2\u6237\u54C8"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 76
      order: 7
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u2026\u2026\u597D\u5BB6\u4F19\uFF0C\u80CC\u4E0A\u780C\u4E86\u4E00\u5835\u5899\u554A\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 77
      order: 8
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u53BB\u5427\uFF0C\u4ECA\u5929\u8FD9\u6D3B\u513F\u8D39\u624B~"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 78
      order: 9
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5148\u751F\u8FD9\u8FB9\u8BF7~"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 4
    lines:
    - textId: 094
      order: 1
      speakerName: "\u6E05\u6D01\u5DE5"
      portraitSourceName: lihui_qijiegong_jusang
      side: L
      portrait: {fileID: 21300000, guid: 30fe5b071a05dda4c8093721e72c3561, type: 3}
      isLeftPortrait: 1
      text: "\u90A3\u4E2A\u2026\u4E0D\u597D\u610F\u601D\uFF0C\u6211\u53EF\u4EE5\u8FDB\u6765\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 095
      order: 2
      speakerName: "\u6E05\u6D01\u5DE5"
      portraitSourceName: lihui_qijiegong_jusang
      side: L
      portrait: {fileID: 21300000, guid: 30fe5b071a05dda4c8093721e72c3561, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u662F\u8BF4\u2026\u2026\u5982\u679C\u4E0D\u65B9\u4FBF\u7684\u8BDD\uFF0C\u6211\u5C31\u8D70\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 096
      order: 3
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u8BF6\uFF01\u8FD9\u8BDD\u5C31\u4E0D\u5BF9\u4E86\uFF0C\u8BF7\u8FDB\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 097
      order: 4
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u54EA\u6709\u628A\u5BA2\u4EBA\u5F80\u5916\u8D76\u7684\u9053\u7406\uFF1F\u5FEB\u8FDB\u6765\uFF0C\u6211\u4EEC\u521A\u5F00\u5F20\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 098
      order: 5
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4ED6\u5728\u8FD9\u626B\u4E86\u4E09\u5E74\u5730\uFF0C\u4F60\u662F\u7B2C\u4E00\u4E2A\u8BF7\u4ED6\u8FDB\u6765\u7684\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 099
      order: 6
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u60F3\u4E0D\u5230\u5440\uFF0C\u4F60\u8FD8\u86EE\u6709\u5FC3\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 100
      order: 7
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u8FD9\u662F...\u6839\u672C\u770B\u4E0D\u6E05\u5440\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 101
      order: 8
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5F53\u4E00\u53EA\u9F20\u88AB\u957F\u671F\u65E0\u89C6\uFF0C\u5B83\u5728\u522B\u4EBA\u7684\u773C\u91CC\u662F\u4EC0\u4E48\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 102
      order: 9
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5B83\u73B0\u5728\u5C31\u50CF\u6478\u4E0D\u7740\u6293\u4E0D\u7740\u7684\u6CE1\u6CE1\uFF0C\u6240\u4EE5\u4F60\u770B\u4E0D\u6E05\u3002"
      backgroundImage: {fileID: 0}
    - textId: 103
      order: 10
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u9488\u5BF9\u8FD9\u6837\u7684\u987E\u5BA2\u591A\u4F7F\u7528\u5EF6\u7F13\u5BF9\u65B9\u884C\u52A8\u7684\u6280\u80FD\uFF08blur\uFF09\uFF0C\u8BB0\u4F4F\uFF01\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 104
      order: 11
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u8BB0\u4F4F\u4E86..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 5
    lines:
    - textId: 117
      order: 1
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5C0F\u5B50\uFF0C\u770B\u4F60\u8FD9\u51E0\u5929\u6CA1\u5C11\u6512\u94B1\u3002\u8FDB\u4E86\u65B0\u8D27\uFF0C\u53BB\u641E\u70B9\u597D\u7528\u7684\u5DE5\u5177\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 118
      order: 2
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan_jusang
      side: L
      portrait: {fileID: 21300000, guid: d8bc113f0b8ef3948b6a4199ac0bff13, type: 3}
      isLeftPortrait: 1
      text: "\u8001\u677F\uFF0C\u5FEB\u5FEB\u5FEB\uFF01\u521A\u521A\u4E0B\u66B4\u96E8\u6211\u9001\u9644\u8FD1\u7684\u5730\u65B9\u641E\u5F97\u5168\u8EAB\u90FD\u6E7F\u4E86\uFF01\u6211\u4E4B\u540E\u8FD8\u8981\u53BB\u627E\u6211\u5973\u513F\uFF0C\u80FD\u7ED9\u6211\u5B89\u6392\u4E00\u4E2A\u624B\u901F\u5FEB\u7684\u5E08\u5085\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 119
      order: 3
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u597D\u561E\u597D\u561E\uFF0C\u522B\u7740\u6025\u5440"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 120
      order: 4
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4ED6\u8EAB\u4E0A\u2026\u2026\u8FD9\u56E2\u75AF\u72C2\u8086\u8650\u7684\u72C2\u98CE\uFF01\u5439\u5F97\u4EBA\u773C\u775B\u90FD\u7741\u4E0D\u5F00\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 121
      order: 5
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6BCF\u5929\u5728\u9A6C\u8DEF\u4E0A\u72C2\u98D9\uFF0C\u6700\u540E\u8FD9\u9635\u5996\u98CE\u5168\u522E\u8FDB\u4E86\u81EA\u5DF1\u5FC3\u91CC\u53BB\u54AF\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 122
      order: 6
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u53BB\u5427\uFF0C\u4ECA\u5929\u5C31\u5F53\u7EC3\u7EC3\u624B\u901F\u3002\u8BA9\u4ED6\u505C\u4E0B\u6765\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 123
      order: 7
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5BF9\u4ED8\u8FD9\u79CD\u654C\u4EBA\u591A\u4F7F\u7528\u7729\u6655\u6280\u80FD\uFF0C\u9632\u6B62\u5BF9\u65B9\u5728\u4E00\u56DE\u5408\u5185\u653B\u51FB\u4F60\u591A\u6B21"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 124
      order: 8
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u5662\uFF0C\u8FD8\u8981\u6CE8\u610F\u70B9\uFF0C\u522B\u5F04\u4E71\u8001\u5A18\u7684\u53D1\u578B\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 125
      order: 9
      speakerName: "\u5C0F\u798F"
      portraitSourceName: lihui_dafu_pibei
      side: R
      portrait: {fileID: 21300000, guid: 9dd247752bf53b44bb26469a85071715, type: 3}
      isLeftPortrait: 0
      text: "\u597D\u7684\uFF0C\u8001\u677F..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
