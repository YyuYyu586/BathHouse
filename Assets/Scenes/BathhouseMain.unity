      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u68C0\u67E5\u5355\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 20
      order: 20
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u5176\u5B9E\u4E0D\u662F\u6211\u751F\u75C5\u3002\u662F\u6211\u5988\u524D\u9635\u5B50\u67E5\u51FA\u6765\u8840\u7CD6\u4E0D\u592A\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 21
      order: 21
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u533B\u751F\u8BF4\u8981\u957F\u671F\u6CE8\u610F\uFF0C\u996E\u98DF\u3001\u8FD0\u52A8\u3001\u590D\u67E5\uFF0C\u90FD\u8981\u6162\u6162\u6765\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 22
      order: 22
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u5988\u5012\u662F\u8FD8\u7B11\u6211\uFF0C\u8BF4\u201C\u4F60\u600E\u4E48\u6BD4\u6211\u8FD8\u7D27\u5F20\u201D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 23
      order: 23
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u7ED9\u4F60\u7EB8\u5DFE\u2026\u2026"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 24
      order: 24
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
