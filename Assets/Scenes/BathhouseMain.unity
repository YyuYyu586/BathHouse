      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6211\u8981\u5B66\uFF01"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: 
      side: 
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u5C0F\u798F\u5F88\u6709\u5929\u8D4B......"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: 
      side: 
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u975E\u5E38\u5FEB\u7684\u5C31\u638C\u63E1\u4E86\u6280\u80FD\u3010\u7EC8\u7ED3\u3011\u7075\u9B42\u629B\u5149\uFF01\uFF01"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u5929\u54EA\u8FD9\u662F\u4EC0\u4E48\uFF01\u8FD9\u795E\u5947\u7684\u80A5\u7682\uFF0C\u8FD9\u6837\u8FD0\u7528\u80FD\u53D1\u6325\u5982\u6B64\u5F3A\u5927\u7684\u6548\u679C\uFF01\uFF01"
      backgroundImage: {fileID: 0}
    - textId: 
      order: 0
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u54FC\u54FC\uFF0C\u597D\u597D\u7528\uFF0C\u8FD8\u597D\u4F60\u8FD9\u4E48\u5FEB\u5C31\u5B66\u4F1A\u4E86\uFF0C\u4E0A\u4E00\u4E2A\u6211\u6559\u7684\u5B66\u4E0D\u4F1A\u7684\u4EBA\u5DF2\u7ECF\u88AB\u6211\u6413\u6210\u9F20\u9F20\u7403\u4E86\uFF01"
      backgroundImage: {fileID: 0}
  - dayName: 
    lines: []
  - dayName: Day 7
    lines:
