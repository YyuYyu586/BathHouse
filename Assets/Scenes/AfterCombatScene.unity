      isLeftPortrait: 1
      text: "\u542C\u8BF4\u9644\u8FD1\u65B0\u5F00\u4E86\u4E00\u5BB6\u706B\u9505\u5E97\uFF0C\u5148\u4E0D\u7BA1\u522B\u7684\u4E86\uFF0C\u6211\u8981\u597D\u597D\u7292\u52B3\u4E00\u4E0B\u81EA\u5DF1!"
