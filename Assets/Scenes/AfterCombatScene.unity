      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u5BB3\uFF01\u7ED3\u679C\u4E0B\u4E2A\u5927\u66B4\u96E8\u641E\u5F97\u6D51\u8EAB\u6E7F\u6F09\u6F09...\u5DEE\u70B9\u5C31\u8981\u5E26\u7740\u4E00\u8EAB\u6C34\u6C14\u56DE\u53BB\u89C1\u5979\u4E86\uFF0C\u771F\u591F\u8822\u7684\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 139
      order: 23
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u5728\u4F60\u8FD9\u513F\u6D17\u5E72\u51C0\u4E86\uFF0C\u6211\u5C31\u8981\u5E72\u5E72\u51C0\u51C0\u56DE\u5BB6\u597D\u597D\u966A\u5BB6\u4EBA\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 140
      order: 24
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u8FD9\u5C31\u5BF9\u561B\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 141
      order: 25
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u8001\u677F\uFF0C\u8C22\u4E86\uFF0C\u4E0D\u7528\u627E\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 142
      order: 26
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\uFF08\u54FC\u5531\uFF09\u6211\u4EEC\u90FD\u5728\u7528\u529B\u5730\u6D3B\u7740~"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 143
      order: 27
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u884C\u4E86\u4E0B\u6B21\u6765\u54C8\uFF01\u5582\uFF0C\u4E0D\u7528\u627E\u4E86\u662F\u4F55\u610F\u5473\uFF0C\u4F60\u626B\u7801\u591A\u4ED8\u94B1\u4E86\u5417?"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 144
      order: 28
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u8FD8\u771F\u591A\u4ED8\u4E86\uFF0C\u4E0B\u6B21\u6765\u7ED9\u4F60\u6253\u6298\u554A\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 6
    lines:
    - textId: 154
      order: 9
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 613c44c6ad7acb04dacc987a793ec008, type: 3}
      isLeftPortrait: 1
      text: "...\u8111\u5B50\u7A81\u7136\u597D\u6E05\u9759\uFF0C\u521A\u624D\u6211\u5230\u5E95\u5728\u53D1\u4EC0\u4E48\u75AF\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 155
      order: 10
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u563F\uFF0C\u4F60\u7684\u5E73\u677F\u8FD8\u653E\u7740\u5462\uFF0C\u8BFE\u4E0D\u542C\u5566\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 156
      order: 11
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 613c44c6ad7acb04dacc987a793ec008, type: 3}
      isLeftPortrait: 1
      text: "\u55EF...\u521A\u521A\u7A81\u7136\u60F3\u660E\u767D\u4E00\u4EF6\u4E8B\u3002\u5982\u679C\u6211\u5377\u8D62\u4E86\u8FD9\u5E2E\u4EBA\uFF0C\u7ED3\u679C\u53C8\u80FD\u600E\u4E48\u6837\u5462\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 157
      order: 12
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 613c44c6ad7acb04dacc987a793ec008, type: 3}
      isLeftPortrait: 1
      text: "\u5728\u8FD9\u513F\u62FC\u6B7B\u62FC\u6D3B\u5730\u5377\uFF0C\u6700\u540E\u4E0D\u4E5F\u662F\u7ED9\u81EA\u5DF1\u62A2\u4E00\u5757\u98CE\u6C34\u597D\u70B9\u7684\u5893\u5730\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 158
      order: 13
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 613c44c6ad7acb04dacc987a793ec008, type: 3}
      isLeftPortrait: 1
      text: "\u4EE5\u524D\u5929\u5929\u542C\u7740\u8EAB\u8FB9\u8FD9\u4E9B\u566A\u97F3\uFF0C\u611F\u89C9\u81EA\u5DF1\u597D\u50CF\u88AB\u6D17\u8111\u4E86\uFF0C\u5176\u5B9E\u6839\u672C\u4E0D\u77E5\u9053\u81EA\u5DF1\u8981\u505A\u4EC0\u4E48\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 159
      order: 14
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 613c44c6ad7acb04dacc987a793ec008, type: 3}
      isLeftPortrait: 1
      text: "\u8BF4\u8D77\u6765\uFF0C\u7535\u8111\u91CC\u5B58\u7740\u4E00\u4E2A\u505A\u4E86\u534A\u5E74\u7684\u6E38\u620F\u4F01\u5212\u6848\u2026\u2026\u6211\u60F3\u8BD5\u8BD5\u90A3\u6761\u8DEF\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 160
      order: 15
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u9177\u554A\uFF01\u90A3\u4F60\u8FD8\u5728\u7B49\u4EC0\u4E48\uFF1F\u8D76\u7D27\u56DE\u53BB\u505A\u5427\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 161
      order: 16
      speakerName: "\u5927\u5B66\u751F\u9F20"
      portraitSourceName: lihui_daxuesheng_weixiao
      side: L
      portrait: {fileID: 21300000, guid: 613c44c6ad7acb04dacc987a793ec008, type: 3}
      isLeftPortrait: 1
      text: "\u8FD9\u5C31\u53BB\u3002\u5929\u584C\u4E0B\u6765\uFF0C\u4E5F\u4E0D\u4F1A\u600E\u4E48\u6837\uFF0C\u5982\u679C\u6211\u5728\u81EA\u5DF1\u6709\u9650\u7684\u4EBA\u751F\u91CC\u6CA1\u6CD5\u505A\u81EA\u5DF1\u60F3\u505A\u7684\u4E8B\uFF0C\u90A3\u592A\u9057\u61BE\u4E86\u3002\u665A\u5B89\uFF0C\u8FD9\u4E2A\u64CD\u86CB\u7684\u5185\u5377\u4E16\u754C\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 162
      order: 17
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u606D\u559C\u4F60\u554A\u5C0F\u798F\u8001\u677F\uFF0C\u53C8\u6210\u529F\u7B56\u53CD\u4E86\u4E00\u4E2A\u4F18\u8D28\u7684\u793E\u4F1A\u725B\u9A6C\u3002\u518D\u8FD9\u4E48\u6413\u4E0B\u53BB\uFF0C\u8FD9\u57CE\u5E02\u7684
        GDP \u90FD\u8981\u88AB\u4F60\u6413\u4E0B\u964D\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 163
      order: 18
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u964D\u5C31\u964D\u5457\uFF0C\u53CD\u6B63\u4E5F\u6CA1\u5206\u7ED9\u6211\u3002\u53CD\u6B63\u6211\u5728\u4F60\u8FD9\u513F\u5E72\u7684\u633A\u5F00\u5FC3"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 7
    lines:
    - textId: 173
      order: 10
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u54C7\uFF0C\u5929\u54EA\u5C0F\u798F\uFF0C\u4F60\u8FD9\u662F\u771F\u8BA9\u6211\u522E\u76EE\u76F8\u770B\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 174
      order: 10
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u8FD9\u6837\u7684\u5F3A\u5927\u7684\u4E1C\u897F\u6211\u8FD8\u662F\u7B2C\u4E00\u6B21\u89C1.....\u8C8C\u4F3C\u662F\u8FD9\u9644\u8FD1\u7684\u8D1F\u9762\u60C5\u7EEA\u90FD\u6C47\u96C6\u5230\u5B83\u4E00\u4EBA\u8EAB\u4E0A\u4E86"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 175
      order: 10
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u624D\u51FA\u73B0\u8FD9\u6837\u7684\u4E1C\u897F\uFF0C\u4E0D\u8FC7\u8FD8\u597D\u4F60\u6CA1\u4E8B......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 176
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u545C\u545C\u545C\u2026\u2026"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 177
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u592A\u7D2F\u4E86\u2026\u2026\u6211\u6BCF\u5929\u88C5\u5F97\u50CF\u4E2A\u6CA1\u6709\u611F\u60C5\u7684\u72E0\u4EBA\uFF0C\u53EF\u6211\u8FDE\u4E2A\u5B8C\u6574\u7684\u5468\u672B\u90FD\u6CA1\u8FC7\u8FC7\u2026\u2026"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 178
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4E5F\u4E0D\u60F3\u534A\u591C\u7ED9\u4ED6\u4EEC\u6253\u7535\u8BDD\uFF0C\u53EF\u662F\uFF0C\u6211\u4E0D\u903C\u4ED6\u4EEC\uFF0C\u8001\u677F\u5C31\u903C\u6211..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 179
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u4E0A\u5468\u6211\u5988\u4F4F\u9662\uFF0C\u90FD\u53EA\u6562\u8BF7\u534A\u5929\u5047..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 180
      order: 10
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u54CE\uFF0C\u54ED\u51FA\u6765\u5C31\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 181
      order: 10
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u8FD9\u91CC\u53EA\u6709\u8212\u670D\u7684\u70ED\u6C34\uFF0C\u6CA1\u6709\u90A3\u4E9B\u5DE5\u4F5C\u7684\u7410\u4E8B\u3002\u4F60\u8981\u662F\u613F\u610F\uFF0C\u5728\u8FD9\u6C60\u5B50\u91CC\u6CE1\u53D1\u4E86\u90FD\u6CA1\u4EBA\u7BA1\u4F60\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 182
      order: 10
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u5F53\u7136\u6211\u4EEC\u4E0D\u4F1A\u8BA9\u4F60\u6CE1\u53D1\u5728\u91CC\u9762\u7684\uFF0C\u54C8\u54C8\u54C8\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 183
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: XiaoFu
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u8FD8\u8FD9\u4E48\u5E74\u8F7B\uFF0C\u4E3A\u5565\u8981\u8FD9\u4E48\u7D2F\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 184
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: XiaoFu
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u5728\u8FD9\u513F\u8FDE\u4E2A\u5395\u6240\u5355\u95F4\u90FD\u4E70\u4E0D\u8D77\uFF0C\u8FD8\u8981\u62D6\u7740\u968F\u65F6\u731D\u6B7B\u7684\u8EAB\u5B50\u4E3A\u8001\u677F\u7684\u4FDD\u65F6\u6377\u9996\u4ED8\u62FC\u547D\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 185
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: XiaoFu
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u60F3\u6211\u8981\u91CD\u65B0\u601D\u8003\u4E00\u4E0B\u6211\u7684\u672A\u6765\u4E86......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 186
      order: 10
      speakerName: "\u4E3B\u7BA1\u9F20"
      portraitSourceName: XiaoFu
      side: L
      portrait: {fileID: 21300000, guid: 1162d8ec6e0f1e946830d8435f178d12, type: 3}
      isLeftPortrait: 1
      text: "\uFF08\u6253\u5F00\u90E8\u95E8\u7FA4\uFF0C@\u4E86\u7FA4\u91CC\uFF09\u201C\u5468\u672B\u597D\u597D\u4F11\u606F\uFF0C\u8C01\u6562\u52A0\u73ED\u6263\u8C01\u5DE5\u8D44\u3002\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 187
      order: 10
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
