      isLeftPortrait: 1
      text: "\u554A\u592A\u597D\u4E86\u54C8\u54C8\uFF0C\u653E\u5FC3\u5427\uFF0C\u5B83\u53EF\u662F\u6211\u4EEC\u8FD9\u513F\u7684\u91D1\u724C\u6413\u6FA1\u5DE5\uFF01"
