      text: "\u8C22\u8C22\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 25
      order: 25
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4F60\u5988\u5988\u73B0\u5728\u600E\u4E48\u6837\u4E86\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 26
      order: 26
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u5B83\u8FD8\u597D\u3002\u5C31\u662F\u2026\u2026\u6211\u4EEC\u4FE9\u73B0\u5728\u5403\u996D\u53D8\u5F97\u5F88\u5947\u602A\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 27
      order: 27
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u5947\u602A\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 28
      order: 28
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u4EE5\u524D\u6211\u5988\u505A\u7EA2\u70E7\u8089\uFF0C\u6211\u53EA\u4F1A\u8BF4\u201C\u597D\u9999\u201D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 29
      order: 29
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u73B0\u5728\u5B83\u4E00\u7AEF\u4E0A\u6765\uFF0C\u6211\u8111\u5B50\u91CC\u5148\u5192\u51FA\u6765\u7684\u662F\uFF1A\u8FD9\u4E2A\u80FD\u5403\u5417\uFF1F\u4F1A\u4E0D\u4F1A\u592A\u6CB9\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 30
      order: 30
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u6709\u4E00\u6B21\u5B83\u5939\u4E86\u4E00\u5757\u8089\uFF0C\u521A\u653E\u8FDB\u7897\u91CC\uFF0C\u53C8\u81EA\u5DF1\u653E\u56DE\u53BB\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 31
      order: 31
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u5B83\u8FD8\u7B11\u7740\u95EE\u6211\uFF1A\u201C\u8FD9\u4E2A\u662F\u4E0D\u662F\u4E0D\u884C\uFF1F\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 32
      order: 32
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u5F53\u65F6\u4E0D\u77E5\u9053\u600E\u4E48\u56DE\u7B54\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 33
      order: 33
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u8BF4\u201C\u4E0D\u884C\u201D\u50CF\u662F\u5728\u7BA1\u5B83\uFF0C\u8BF4\u201C\u6CA1\u4E8B\u201D\u6211\u53C8\u6015\u81EA\u5DF1\u4E0D\u8D1F\u8D23\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 34
      order: 34
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u5939\u90A3\u5757\u8089\u4E86\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 35
      order: 35
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u554A\uFF1F\u2026\u2026\u6CA1\u6709\u3002\u6211\u5F53\u65F6\u6123\u4F4F\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 36
      order: 36
      speakerName: "\u5C0F\u798F"
