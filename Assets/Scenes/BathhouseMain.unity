      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u90A3\u6700\u8FD1\u5462\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 37
      order: 37
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u8FD9\u51E0\u5929\u4E00\u76F4\u5728\u641C\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 38
      order: 38
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u7CD6\u5C3F\u75C5\u80FD\u4E0D\u80FD\u5403\u6C34\u679C\uFF0C\u80FD\u4E0D\u80FD\u559D\u7CA5\uFF0C\u80FD\u4E0D\u80FD\u5403\u7EA2\u70E7\u8089\uFF0C\u996D\u540E\u8D70\u591A\u4E45\u6BD4\u8F83\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 39
      order: 39
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u4E00\u5F00\u59CB\u6211\u4EE5\u4E3A\u67E5\u6E05\u695A\u5C31\u5B89\u5FC3\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 40
      order: 40
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u53EF\u662F\u8D8A\u67E5\u8D8A\u70E6\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 41
      order: 41
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u6BCF\u4E2A\u7B54\u6848\u540E\u9762\u90FD\u8DDF\u7740\u4E00\u4E2A\u201C\u4F46\u662F\u201D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 42
      order: 42
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamstercry
      side: L
      portrait: {fileID: 21300000, guid: 8be44b688dd7f2d48b801e2760fda34e, type: 3}
      isLeftPortrait: 1
      text: "\u800C\u4E14\u6BCF\u6761\u76F8\u5173\u5E16\u5B50\u540E\u9762\u90FD\u6709\u5F88\u591A\u56DE\u590D\uFF0C\u8D8A\u770B\u8D8A\u89C9\u5F97\u81EA\u5DF1\u54EA\u91CC\u90FD\u6CA1\u505A\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 43
      order: 43
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u67E5\u7684\u4E0D\u662F\u7EA2\u70E7\u8089\uFF0C\u4E5F\u4E0D\u662F\u996E\u98DF\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 44
      order: 44
      speakerName: "\u5BB6\u5C5E\u9F20"
      portraitSourceName: FamilyCareHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u2026\u2026\u90A3\u6211\u67E5\u7684\u662F\u4EC0\u4E48\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
