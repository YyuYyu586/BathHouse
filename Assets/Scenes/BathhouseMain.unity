      portrait: {fileID: 21300000, guid: 14b63b62895ec884a8bcc97ccd3045db, type: 3}
      isLeftPortrait: 1
      text: "\u55EF\u3002\u6709\u4EBA\u8BF4\u8FD9\u91CC\u5F88\u9002\u5408\u653E\u677E\uFF0C\u6211\u521A\u597D\u4E5F\u5237\u5230\u4F60\u4EEC\u5728
        X \u97F3\u505A\u5BA3\u4F20\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 14
