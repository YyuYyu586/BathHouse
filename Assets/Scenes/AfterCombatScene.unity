      isLeftPortrait: 0
      text: "\u4EC0\u4E48\u56DE\u4E8B\uFF01\uFF1F\u90A3\u4E9B\u539A\u539A\u7684\u4E1C\u897F...\u53C8\u8D34\u56DE\u4E86\u4ED6\u7684\u80CC\u4E0A\u4E86"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 85
      order: 16
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u522B\u770B\u4E86\uFF0C\u8116\u5B50\u90FD\u8981\u4F38\u6210\u957F\u9888\u9E7F\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 86
      order: 17
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4ED6\u5728\u90A3\u628A\u6905\u5B50\u4E0A\u5750\u4E00\u5929\uFF0C\u90A3\u5757\u4E1C\u897F\u5C31\u4E00\u76F4\u5728\uFF0C\u4E5F\u662F\u4E3A\u4E86\u4FDD\u62A4\u81EA\u5DF1\u5427\uFF0C\u4EE5\u81EA\u5DF1\u7684\u672C\u6211\u9762\u5BF9\u8FD9\u4E9B\u4E1C\u897F\u662F\u4E2A\u4EBA\u90FD\u53D7\u4E0D\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 87
      order: 18
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u53EF\u521A\u624D\u660E\u660E\u90FD\u6D17\u5E72\u51C0\u4E86\u2026"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 88
      order: 19
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u884C\u4E86\uFF0C\u6536\u8D77\u4F60\u90A3\u60B2\u5929\u60AF\u4EBA\u7684\u8868\u60C5\u3002\u81F3\u5C11\u8FD9\u4E00\u5C0F\u4F1A\u513F\uFF0C\u4ED6\u81F3\u5C11\u662F\u7545\u5FEB\u7684\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 89
      order: 20
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4ECA\u5929\u5C31\u8FD9\u6837\uFF0C\u6211\u60F3\u6536\u5DE5\u4E86\uFF0C\u5FD8\u8BB0\u8BF4\u4E86\uFF0C\u6BCF\u4E2A\u670810\u53F7\u53D1\u5DE5\u8D44\u54C8\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 90
      order: 21
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u6EDA\u56DE\u5BB6\u7761\u89C9\u53BB\uFF0C\u4F60\u4E0D\u5ACC\u7D2F\u8001\u5A18\u6570\u94B1\u90FD\u5FEB\u6570\u9EBB\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
  - dayName: Day 4
    lines:
    - textId: 105
      order: 12
      speakerName: "\u6E05\u6D01\u5DE5"
      portraitSourceName: lihui_qijiegong_jusang
      side: L
      portrait: {fileID: 21300000, guid: 30fe5b071a05dda4c8093721e72c3561, type: 3}
      isLeftPortrait: 1
      text: "\u4EE5\u524D...\u5927\u5BB6\u770B\u89C1\u6211\u90FD\u7ED5\u9053\u8D70..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 106
      order: 13
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u9F20\u9F20\uFF0C\u60A8\u522B\u7BA1\u5916\u5934\u90A3\u4E9B\u4E0D\u957F\u773C\u7684\u4EBA\u600E\u4E48\u770B\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 107
      order: 14
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6BCF\u5929\u8D77\u65E9\u8D2A\u9ED1\uFF0C\u628A\u8FD9\u57CE\u5E02\u6536\u62FE\u5F97\u5E72\u5E72\u51C0\u51C0\uFF0C\u8981\u662F\u6CA1\u6709\u4F60\uFF0C\u9F20\u4EEC\u8FDE\u5757\u5E72\u51C0\u7684\u5730\u513F\u90FD\u8E29\u4E0D\u4E0A\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 108
      order: 15
      speakerName: "\u5C0F\u798F"
      portraitSourceName: 
      side: 
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6211\u77E5\u9053\u8FD9\u9644\u8FD1\u6709\u5927\u5B66\uFF0C\u6240\u4EE5\u521A\u597D\u4E5F\u6709\u5730\u644A\uFF0C\u90A3\u4E00\u7247\u6700\u96BE\u6E05\u7406\u4E86\u5427......"
      backgroundImage: {fileID: 0}
    - textId: 109
      order: 16
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6240\u4EE5\u6211\u4EEC\u8FD9\u513F\uFF0C\u5C31\u662F\u4E3A\u4E86\u6D17\u6389\u9F20\u9F20\u4EEC\u8EAB\u4E0A\u7684\u75B2\u60EB\u4E0E\u59D4\u5C48\u800C\u5B58\u5728\uFF0C\u5E0C\u671B\u4F60\u6EE1\u610F\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 110
      order: 17
      speakerName: "\u6E05\u6D01\u5DE5"
      portraitSourceName: lihui_qinjiegog
      side: L
      portrait: {fileID: 21300000, guid: d1e45009b3af2f544aa17ff7502a591c, type: 3}
      isLeftPortrait: 1
      text: "\u54CE...\u8FD9\u8BDD\u8BF4\u5F97\u6211\u5FC3\u91CC\u771F\u662F...\u4ECA\u5929\u771F\u662F\u8C22\u8C22\u4F60\u4E86\uFF0C\u5C0F\u9F20\u9F20\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 111
      order: 18
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u591A\u5927\u70B9\u4E8B\u513F\uFF01\u6D17\u5B8C\u8212\u8212\u670D\u670D\u7761\u4E00\u89C9\uFF0C\u4EE5\u540E\u7D2F\u4E86\u968F\u65F6\u6765\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 112
      order: 19
      speakerName: "\u6211\u662F\u65C1\u767D"
      portraitSourceName: none
      side: none
      portrait: {fileID: 0}
      isLeftPortrait: 0
      text: "\u7B2C\u4E8C\u5929\u591C\u665A\uFF0C\u6E05\u6D01\u5DE5\u9F20\u9F20\u6B63\u5728\u8857\u4E0A\u626B\u5730\u3002"
      backgroundImage: {fileID: 21300000, guid: 25660153abcce604d9a149d68b422020, type: 3}
    - textId: 113
      order: 20
      speakerName: "\u5B9E\u4E60\u751F\u9F20\u9F20"
      portraitSourceName: lihui_shixisheng
      side: L
      portrait: {fileID: 21300000, guid: 9ea448a3cebae334db0f920b7e3992d2, type: 3}
      isLeftPortrait: 1
      text: "\u9F20\u53D4\uFF0C\u591A\u4E8F\u4F60\u4ECA\u65E9\u628A\u8DEF\u53E3\u7684\u79EF\u6C34\u6E05\u7406\u4E86\uFF0C\u4E0D\u7136\u6211\u8D76\u65E9\u9AD8\u5CF0\u975E\u5F97\u6454\u4E00\u8DE4\u4E0D\u53EF\u54C8\u54C8\u54C8\uFF01\u6700\u8FD1\u4E0B\u96E8\u90A3\u8FB9\u8001\u662F\u6E7F\u6F09\u6F09\u7684......"
      backgroundImage: {fileID: 21300000, guid: 25660153abcce604d9a149d68b422020, type: 3}
    - textId: 114
      order: 21
      speakerName: "\u5B9E\u4E60\u751F\u9F20\u9F20"
      portraitSourceName: lihui_shixisheng
      side: L
      portrait: {fileID: 21300000, guid: 9ea448a3cebae334db0f920b7e3992d2, type: 3}
      isLeftPortrait: 1
      text: "\u7ED9\uFF0C\u521A\u4E70\u7684\u70ED\u8336\uFF0C\u8F9B\u82E6\u4E86\uFF01"
      backgroundImage: {fileID: 21300000, guid: 25660153abcce604d9a149d68b422020, type: 3}
    - textId: 115
      order: 22
      speakerName: "\u6E05\u6D01\u5DE5"
      portraitSourceName: lihui_qinjiegog
      side: L
      portrait: {fileID: 21300000, guid: d1e45009b3af2f544aa17ff7502a591c, type: 3}
      isLeftPortrait: 1
      text: "\u8C22\u8C22\u4F60\u5C0F\u9F20\uFF01\u4F60\u7684\u5FC3\u610F\u6211\u6536\u4E0B\u4E86\u3002"
      backgroundImage: {fileID: 21300000, guid: 25660153abcce604d9a149d68b422020, type: 3}
    - textId: 116
      order: 23
      speakerName: "\u6E05\u6D01\u5DE5"
      portraitSourceName: lihui_qinjiegog
      side: L
      portrait: {fileID: 21300000, guid: d1e45009b3af2f544aa17ff7502a591c, type: 3}
      isLeftPortrait: 1
      text: "\uFF08\u5B83\u63E1\u7740\u90A3\u676F\u8336\uFF0C\u5FC3\u91CC\u611F\u5230\u65E0\u6BD4\u6E29\u6696\u3002\uFF09"
      backgroundImage: {fileID: 21300000, guid: 25660153abcce604d9a149d68b422020, type: 3}
  - dayName: Day 5
    lines:
    - textId: 126
      order: 10
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "...\u6211\u4E4B\u524D\u603B\u662F\u5306\u5306\u5FD9\u5FD9\uFF0C\u6211\u5373\u4F7F\u5DF2\u7ECF\u5F88\u5FEB\u4E86\uFF0C\u4F46\u6211\u6C38\u8FDC\u89C9\u5F97\u6211\u7684\u65F6\u95F4\u4E0D\u591F\u7528......"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 127
      order: 11
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u8FD9\u5E73\u53F0\u4E00\u76F4\u5728\u66F4\u65B0\u673A\u5236\uFF0C\u6211\u5DF2\u7ECF\u4E0D\u77E5\u9053\u591A\u5C11\u6B21\u4E3A\u4E86\u8D76\u65F6\u95F4\u95EF\u7EA2\u706F\u4E86"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 128
      order: 12
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4E5F\u4E0D\u60F3\u9006\u884C\u3001\u5728\u8F66\u6D41\u91CC\u7A7F\u68AD\uFF0C\u6211\u4E5F\u60DC\u547D\u554A\uFF0C\u53EF\u662F\u6211\u4E4B\u524D\u5E72\u81EA\u5DF1\u7684\u751F\u610F...\u54CE...\u4E0D\u8BF4\u4E86"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 129
      order: 13
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u5373\u4F7F\u6211\u73B0\u5728\u6709\u5B58\u6B3E\uFF0C\u4F46\u6211\u4E5F\u4E0D\u80FD\u5750\u5403\u5C71\u7A7A..."
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 130
      order: 14
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4E5F\u60F3\u81EA\u7531\uFF0C\u4F46\u662F\u8FD9\u4E0D\u662F\u60F3\u5E72\u4EC0\u4E48\u5C31\u5E72\u4EC0\u4E48"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 131
      order: 15
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4E4B\u524D\u7684\u5408\u4F19\u5931\u8D25\u5DF2\u7ECF\u8BA9\u6211\u8BA4\u8BC6\u5230\u4E86\uFF0C\u81EA\u7531\u662F\u6709\u80FD\u529B\u9009\u62E9\u81EA\u5DF1\u4E0D\u505A\u4EC0\u4E48"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 132
      order: 16
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u4E3A\u4E86\u6211\u7684\u5BB6\u4EBA.....\u6211\u4E0D\u80FD\u653E\u5F03"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 133
      order: 17
      speakerName: "\u5C0F\u798F"
      portraitSourceName: lihui_waimaiyuan
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u597D\uFF0C\u6C38\u8FDC\u4E0D\u8981\u653E\u5F03\uFF0C\u4F46\u4E5F\u4E0D\u8981\u5FD8\u8BB0\u4F11\u606F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 134
      order: 18
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4F60\u770B\u505C\u4E0B\u6765\u653E\u677E\u4E0B\u7684\u611F\u89C9\u53EF\u4EE5\u5427\uFF0C\u6211\u8FD9\u624B\u901F\u548B\u6837\uFF1F\u4E94\u661F\u597D\u8BC4\u5B89\u6392\u4E00\u4E0B\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 135
      order: 19
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u597D\u597D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 136
      order: 20
      speakerName: "\u5916\u5356\u5458\u9F20"
      portraitSourceName: lihui_waimaiyuan
      side: L
      portrait: {fileID: 21300000, guid: dd933d8af58c5ab49868a4204b8cec24, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4ECA\u5929\u672C\u6765\u60F3\u7740\u518D\u9001\u8FD9\u4E00\u4E0B\uFF0C\u7ED9\u6211\u95FA\u5973\u4E70\u751F\u65E5\u793C\u7269\u7684...\uFF08\u4ECE\u53E3\u888B\u91CC\u638F\u51FA\u4E00\u4E2A\u634F\u76B1\u7684\u5C0F\u793C\u76D2\uFF09"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 137
      order: 21
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u6F02\u4EAE\u7684\u53D1\u5939\uFF0C\u4F60\u5973\u513F\u4E00\u5B9A\u4F1A\u559C\u6B22\u7684\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 138
      order: 22
