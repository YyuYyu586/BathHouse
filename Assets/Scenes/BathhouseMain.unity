      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u7B2C\u4E00\u6B21\u6765\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 149
      order: 149
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u55EF\u2026\u6211\u8DEF\u8FC7\uFF0C\u7A81\u7136\u60F3\u6413\u4E2A\u6FA1"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 150
      order: 150
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u4F60\u770B\u8D77\u6765\u6709\u70B9\u7D2F\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 151
      order: 151
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u662F\u5417\u2026\u2026\u53EF\u80FD\u6700\u8FD1\u6CA1\u600E\u4E48\u7761\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 152
      order: 152
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\uFF08\u9012\u8336\uFF09\u5148\u5750\u4F1A\u513F\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 153
      order: 153
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u8C22\u8C22\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 154
      order: 154
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\uFF08\u6367\u7740\u8336\uFF0C\u6CA1\u559D\uFF09\u2026\u2026\u6211\u4EE5\u524D\u559D\u4E1C\u897F\uFF0C\u4E0D\u4F1A\u60F3\u8FD9\u4E48\u591A\u7684\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 155
      order: 155
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u73B0\u5728\u4E0D\u559C\u6B22\u4E86\u5417\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 156
      order: 156
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u4E5F\u4E0D\u662F\u3002\u5C31\u662F\u2026\u2026\u6700\u8FD1\u4E0D\u7BA1\u5403\u4EC0\u4E48\u559D\u4EC0\u4E48\uFF0C\u8111\u5B50\u91CC\u90FD\u4F1A\u6709\u4E00\u4E2A\u58F0\u97F3\u95EE\uFF1A\u201C\u8FD9\u4E2A\u884C\u4E0D\u884C\uFF1F\u201D"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 157
      order: 157
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u53D1\u751F\u4EC0\u4E48\u4E86\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 158
      order: 158
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u2026\u2026\u6211\u6700\u8FD1\u786E\u8BCA\u4E86\u7CD6\u5C3F\u75C5\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 159
      order: 159
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u67E5\u4E86\u597D\u591A\u4E1C\u897F\u3002\u4EC0\u4E48\u80FD\u5403\uFF0C\u4EC0\u4E48\u8981\u5C11\u5403\uFF0C\u4F4E\u8840\u7CD6\u4F1A\u662F\u4EC0\u4E48\u611F\u89C9\uFF0C\u4EE5\u540E\u53C8\u8981\u590D\u67E5\u4EC0\u4E48\u2026\u2026"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 160
      order: 160
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4EE5\u4E3A\u67E5\u6E05\u695A\u4E86\u5C31\u80FD\u5B89\u5FC3\u3002\u53EF\u662F\u8D8A\u67E5\uFF0C\u8D8A\u89C9\u5F97\u6BCF\u4E00\u6761\u90FD\u8FDE\u7740\u53E6\u4E00\u6761\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 161
      order: 161
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u5C31\u50CF\u2026\u2026\u4E00\u56E2\u7EBF\uFF0C\u627E\u4E0D\u5230\u5934\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 162
      order: 162
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u4F60\u662F\u4EC0\u4E48\u65F6\u5019\u77E5\u9053\u7684\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 163
      order: 163
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u4E0A\u4E2A\u6708\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 164
      order: 164
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u533B\u751F\u8BF4\u201C\u4EE5\u540E\u8981\u957F\u671F\u7BA1\u7406\u201D\uFF0C\u6211\u5F53\u65F6\u70B9\u4E86\u70B9\u5934\u3002\u4F46\u665A\u4E0A\u56DE\u5230\u5BB6\uFF0C\u5750\u5728\u6C99\u53D1\u4E0A\uFF0C\u5750\u4E86\u4E09\u4E2A\u5C0F\u65F6\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 165
      order: 165
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u8111\u5B50\u91CC\u4E00\u76F4\u5728\u8F6C\uFF1A\u4EE5\u540E\u6BCF\u5929\u90FD\u8981\u8FD9\u6837\u5417\uFF1F\u4E00\u8F88\u5B50\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 166
      order: 166
      speakerName: "\u5C0F\u798F"
      portraitSourceName: XiaoFu
      side: R
      portrait: {fileID: 21300000, guid: ed4e5cfa213d7eb40bc58c908eb575a0, type: 3}
      isLeftPortrait: 0
      text: "\u90A3\u65F6\u5019\u4F60\u5728\u60F3\u4EC0\u4E48\uFF1F"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 167
      order: 167
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamsternormal
      side: L
      portrait: {fileID: 21300000, guid: 219b2427e1be8c84b9309127cc82f094, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u4E5F\u8BF4\u4E0D\u6E05\u3002\u6211\u5C31\u5750\u5728\u90A3\u91CC\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 168
      order: 168
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u540E\u6765\u6211\u5F00\u59CB\u67E5\u8D44\u6599\u3002\u8D8A\u67E5\u8D8A\u89C9\u5F97\u81EA\u5DF1\u4EC0\u4E48\u90FD\u4E0D\u61C2\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 169
      order: 169
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u6709\u65F6\u5019\u67E5\u7740\u67E5\u7740\u5C31\u70E6\u4E86\uFF0C\u628A\u624B\u673A\u6254\u4E00\u8FB9\u3002\u8FC7\u4E00\u4F1A\u513F\u53C8\u6361\u8D77\u6765\uFF0C\u6015\u6F0F\u4E86\u4EC0\u4E48\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 170
      order: 170
      speakerName: "\u91D1\u5AC2"
      portraitSourceName: Jinsao_portrait
      side: L
      portrait: {fileID: 21300000, guid: a06ba5c8fd04bef4a879a17fcf320943, type: 3}
      isLeftPortrait: 1
      text: "\u811A\u90FD\u8FDB\u95E8\u4E86\uFF0C\u5FC3\u8FD8\u5728\u95E8\u53E3\u7AD9\u7740\u5462\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 171
      order: 171
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u2026\u2026\u55EF\u3002\u4E00\u8FB9\u60F3\u5F04\u660E\u767D\uFF0C\u4E00\u8FB9\u4E0D\u60F3\u9762\u5BF9\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 172
      order: 172
      speakerName: "\u65B0\u786E\u8BCA\u9F20\u9F20"
      portraitSourceName: PatientHamstersad
      side: L
      portrait: {fileID: 21300000, guid: 9cf4ce2d2e6aed2459ad973f4975ea53, type: 3}
      isLeftPortrait: 1
      text: "\u6211\u6015\u63A7\u5236\u4E0D\u597D\uFF0C\u6015\u522B\u4EBA\u7684\u773C\u5149\uFF0C\u6015\u6709\u4E00\u5929\u2026\u2026\u81EA\u5DF1\u6491\u4E0D\u4F4F\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 173
      order: 173
      speakerName: "\u7CFB\u7EDF"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u8FD9\u53EA\u9F20\u9F20\u7684\u8D1F\u9762\u60C5\u7EEA\u5DF2\u7ECF\u6E05\u6670\u7684\u5C55\u73B0\u5728\u4E86\u4F60\u7684\u773C\u524D\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 174
      order: 174
      speakerName: "\u7CFB\u7EDF"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u4E00\u56E2\u7EC6\u7EC6\u5BC6\u5BC6\u7684\u4E1C\u897F\u6162\u6162\u6D6E\u4E86\u51FA\u6765\u3002"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 175
      order: 175
      speakerName: "\u7CFB\u7EDF"
      portraitSourceName: none
      side: L
      portrait: {fileID: 0}
      isLeftPortrait: 1
      text: "\u52A0\u6CB9\u5440\uFF01\uFF01"
      backgroundImage: {fileID: 21300000, guid: a29cf2768c2215f4b9c2b86fafc9670f, type: 3}
    - textId: 176
      order: 176
      speakerName: "\u5C0F\u798F"
